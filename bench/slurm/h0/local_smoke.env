# H0 bundle: the DEVELOPMENT MACHINE's overrides for the CPU smoke (not used on HoreKa):
#   SMOKE=1 H0_LOCAL_ENV=bench/slurm/h0/local_smoke.env bash bench/slurm/h0/submit_all.sh
# The local venv (/export/scratch/tbuck/jax0112-venv, the pins in requirements.txt) has jaccpot and yggdrax
# as editable installs of other worktrees: mn-scratch/site's sitecustomize repoints them to WT_JACCPOT /
# WT_YGGDRAX (env.sh sets both); nornax's equinox/diffrax come from the odisseo overlay.
H0_ROOT=/export/scratch/tbuck/mn-scratch/h0/smoke-root
H0_PY_OVERRIDE=/export/scratch/tbuck/jax0112-venv/bin/python
H0_YGGDRAX=/export/home/tbuck/yggdrax-mn-ref
H0_NORNAX=/export/home/tbuck/nornax-mn-ref
H0_MIMIRAX=/export/scratch/tbuck/mn-scratch/h0/smoke-root/src/mimirax
H0_EXTRA_PYTHONPATH=/export/scratch/tbuck/mn-scratch/site:/export/scratch/tbuck/odisseo-overlay
H0_DISC_IC=/export/scratch/tbuck/odisseo_ic/disk_bulge_25m.npz
H0_SKIP_MODULES=1
H0_ACCOUNT=local-smoke
