# H0 bundle: EVERY site-specific value, in one place. Edit this file once on the HoreKa login node
# (setup_env.sh, submit_all.sh, collect.sh and every job read it). Values marked CHANGE_ME have no
# safe default: submit_all.sh refuses to submit while one is left.
#
# Plain `KEY=${KEY:-default}` lines, so an environment variable of the same name overrides a value
# for one call (e.g. `H0_PARTITION=accelerated-h100 bash bench/slurm/h0/submit_all.sh --dry-run`).

# --- SLURM -----------------------------------------------------------------------------------
# Your compute project (`sacctmgr show assoc user=$USER format=account%30` lists them;
# HoreKa projects look like hk-project-<name>).
H0_ACCOUNT=${H0_ACCOUNT:-CHANGE_ME}
# The partition with 4x A100-40GB + NVLink per node. The bundle's numbers are compared with local
# A100-40GB cards, so do not switch to the H100 partition for the baseline.
H0_PARTITION=${H0_PARTITION:-accelerated}
# GPUs per node on that partition (the scaling matrix and the 4-card ceiling assume 4).
H0_GPUS_PER_NODE=${H0_GPUS_PER_NODE:-4}
# Host memory per job (sbatch --mem): 0 = all of the node's (the jobs hold 1e8-particle ICs, fp64
# references and offloaded gradient residuals on the host).
H0_MEM=${H0_MEM:-0}
# Extra sbatch options for every job (a QOS, a reservation, --constraint, a mail address ...).
H0_SBATCH_EXTRA=${H0_SBATCH_EXTRA:-}
# The preflight job's partition: a short development queue if you have one (on HoreKa
# probably `dev_accelerated`; check `sinfo -s`), else the production partition.
H0_PREFLIGHT_PARTITION=${H0_PREFLIGHT_PARTITION:-$H0_PARTITION}

# --- filesystem ------------------------------------------------------------------------------
# One directory for everything H0 writes (the venv, the pinned sibling checkouts, the staged data,
# every job's rows and logs). It needs ~15 GB. On HoreKa use a workspace, not $HOME:
#   ws_allocate h0 60 && ws_find h0
H0_ROOT=${H0_ROOT:-CHANGE_ME}

# --- software --------------------------------------------------------------------------------
# Modules to load before anything else (space separated), or empty. jax's CUDA 12 wheels bring
# their own CUDA libraries, ptxas and NCCL: do NOT load a CUDA module (an older libcudart or ptxas
# on LD_LIBRARY_PATH / PATH shadows the wheels'); only a Python >= 3.12 if the system has none.
# Example (check `module avail python`): H0_MODULES="devel/python/3.12.3"
H0_MODULES=${H0_MODULES:-}
# The interpreter the venv is built from (must be >= 3.12; local runs used CPython 3.12.3).
H0_PYTHON=${H0_PYTHON:-python3.12}
